# Copie para .env (local) ou cadastre na Vercel: Project → Settings → Environment Variables.
# Tudo é opcional; canais vazios simplesmente não aparecem no site.

# Formulário de contato — endpoint que recebe POST JSON. Padrão (vazio): FormSubmit enviando
# para coutstech@gmail.com. Preencha só para trocar por outro serviço ou API própria.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_EMAIL=
# Só dígitos, com DDI e DDD (ex.: 5511999999999)
VITE_WHATSAPP_NUMBER=

# Perfis oficiais (URL completa)
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=
VITE_TIKTOK_URL=

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Sem ID, os eventos só vão para window.dataLayer.
VITE_GA_MEASUREMENT_ID=

# CRM de leads (/admin/crm) — Supabase. Só no servidor: NUNCA use prefixo VITE_ aqui.
# Supabase → Project Settings → API Keys. Sem estas três, o site continua enviando
# o formulário só por e-mail e o painel mostra a tela de configuração.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Origem pública, sem barra final (links de confirmação e recuperação de senha).
APP_URL=https://www.coutstech.com
# Opcional: salt do limite de tentativas do formulário (padrão: a chave secreta).
RATE_LIMIT_SALT=
