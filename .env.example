# Copie para .env (local) ou cadastre na Vercel: Project → Settings → Environment Variables.
# Tudo é opcional; canais vazios simplesmente não aparecem no site.

# Formulário de contato — endpoint que recebe POST JSON (Formspree, Getform, Basin ou API própria).
# Sem ele, o formulário usa o e-mail; sem e-mail, o WhatsApp; sem nenhum, avisa que o envio está indisponível.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_EMAIL=
# Só dígitos, com DDI e DDD (ex.: 5511999999999)
VITE_WHATSAPP_NUMBER=

# Perfis oficiais (URL completa)
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=
VITE_TIKTOK_URL=

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Sem ID, os eventos só vão para window.dataLayer.
VITE_GA_MEASUREMENT_ID=
